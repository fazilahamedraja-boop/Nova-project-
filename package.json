{
  "name": "nova-ecommerce",
  "version": "1.0.0",
  "description": "NOVA - QA Automation Portfolio E-Commerce Application",
  "main": "server/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node server/db/seed.js",
    "seed:reset": "node server/db/seed.js --force",
    "generate:images": "node scripts/generate-product-images.js",
    "postinstall": "node scripts/verify-sqlite.js && node scripts/generate-product-images.js",
    "verify:sqlite": "node scripts/verify-sqlite.js",
    "verify:auth": "node scripts/verify-auth.js",
    "setup": "node server/db/seed.js && node server/index.js"
  },
  "keywords": ["ecommerce", "qa", "portfolio", "automation"],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^11.0.5"
  }
}
